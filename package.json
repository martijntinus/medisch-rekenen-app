{
  "name": "medisch-rekenen-app",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Mobile-first statische oefenapp voor medisch rekenen op HBO-V niveau.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8912",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8912",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^25.7.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "^10.4.20",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
